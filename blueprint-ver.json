{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "meta": {
        "title": "D'Colitas Vet",
        "description": "Vista previa del sitio de D'Colitas Vet (sin sesión iniciada).",
        "author": "clazarte"
    },
    "landingPage": "/",
    "preferredVersions": {
        "php": "8.3",
        "wp": "latest"
    },
    "login": false,
    "steps": [
        {
            "step": "setSiteOptions",
            "options": {
                "blogname": "D'Colitas Vet",
                "blogdescription": "Clínica Veterinaria en San Luis, Lima"
            }
        },
        {
            "step": "setSiteLanguage",
            "language": "es_ES"
        },
        {
            "step": "installTheme",
            "themeData": {
                "resource": "url",
                "url": "https://raw.githubusercontent.com/clazarte/dcolitasvet-wp/main/dcolitasvet.zip"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "runPHP",
            "code": "<?php require '/wordpress/wp-load.php'; if ( function_exists( 'dcv_seed' ) ) { dcv_seed(); }"
        }
    ]
}
